{
  "name": "dsh-prompt-filter",
  "version": "0.3.5",
  "description": "Rewrites DeepSeek Harness identity text out of requests sent to selected models (gemini, claude) and renames tool and skill identifiers outbound while restoring the original names in model responses.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*": "./locale/*",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "examples",
    "scripts",
    "test"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check-version": "node scripts/check-version.mjs",
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.4 <4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "prompt-filter",
    "identity",
    "gemini",
    "claude"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lihongxu0221/dsh-prompt-filter.git"
  },
  "homepage": "https://github.com/lihongxu0221/dsh-prompt-filter#readme",
  "bugs": {
    "url": "https://github.com/lihongxu0221/dsh-prompt-filter/issues"
  }
}
